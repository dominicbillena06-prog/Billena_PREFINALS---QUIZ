<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Dominic Billena
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

</head>

<body>

    <nav class="navbar navbar-expand-lg portfolio-navbar">

        <div class="container">

            <a class="navbar-brand"
               asp-controller="Home"
               asp-action="Index">

                DB<span>.</span>

            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar"
                    aria-expanded="false"
                    aria-label="Toggle navigation">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse"
                 id="mainNavbar">

                <ul class="navbar-nav ms-auto align-items-lg-center">

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Index">

                            Home

                        </a>

                    </li>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Projects"
                               asp-action="Index">

                                Projects

                            </a>

                        </li>

                        <li class="nav-item ms-lg-3">

                            <form asp-controller="Account"
                                  asp-action="Logout"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="nav-login-button logout-button">

                                    Logout

                                </button>

                            </form>

                        </li>
                    }
                    else
                    {
                        <li class="nav-item ms-lg-3">

                            <a asp-controller="Account"
                               asp-action="Login"
                               class="nav-login-button">

                                Login

                            </a>

                        </li>
                    }

                </ul>

            </div>

        </div>

    </nav>

    <main>

        @RenderBody()

    </main>

    <footer class="portfolio-footer">

        <div class="container">

            <div>

                <strong>
                    Dominic Billena
                </strong>

                <p>
                    ASP.NET Core MVC Portfolio
                </p>

            </div>

            <div>

                <a href="https://github.com/dominicbillena06-prog"
                   target="_blank">

                    GitHub ↗

                </a>

            </div>

        </div>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync(
        "Scripts",
        required: false)

</body>

</html>